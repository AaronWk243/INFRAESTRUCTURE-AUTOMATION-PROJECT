{
  "Dhcp4": {
    "interfaces-config": {
      "interfaces": [ "vlan10", "vlan20" ],
      "dhcp-socket-type": "raw"
    },
  
    "control-socket": {
        "socket-type": "unix",
        "socket-name": "/tmp/kea4-ctrl-socket"
    },
  
    "lease-database": {
      "type": "postgresql",
      "host": "127.0.0.1",
      "port": 5432,
      "name": "db_postgreschangedb",
      "user": "user_postgreschangeuser",
      "password": "postgreschangepassword",
      "lfc-interval": 3600
    },
  
    "authoritative": true,
  
    "subnet4": [
      {
        "id": 1,
        "subnet": "VLAN10_CDIR",
        "pools": [ { "pool": "VLAN10_POOL_WE" } ],
        "option-data": [
          {
            "name": "routers",
            "data": "VLAN10_GATEWAY"
          }
        ],
        "valid-lifetime": 1209600,
        "renew-timer": 604800,
        "rebind-timer": 1058400
      },
      {
        "id": 2,
        "subnet": "VLAN20_CDIR",
        "pools": [ { "pool": "VLAN20_POOL_WE" } ],
        "option-data": [
          {
            "name": "routers",
            "data": "VLAN20_GATEWAY"
          },
          {
            "name": "domain-name-servers",
            "data": "VLAN20_DNS_SERVER"
          }
        ],
        "valid-lifetime": 14400,
        "renew-timer": 7200,
        "rebind-timer": 12600
      }
    ]
  }
}
