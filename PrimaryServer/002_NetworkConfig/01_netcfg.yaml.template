network:
  version: 2
  renderer: networkd
  ethernets:
    ifazXchange:
      dhcp4: false

  vlans:
    vlan10:
      id: 10
      link: ifazXchange
      addresses:
        - VLAN10_SERVER_IP_WM
    vlan20:
      id: 20
      link: ifazXchange
      addresses:
        - VLAN20_SERVER_IP_WM
      routes:
        - to: default
          via: VLAN20_GATEWAY 
      nameservers:
        addresses: [VLAN20_SERVER_IP_NM]